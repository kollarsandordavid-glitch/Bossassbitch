{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neural-search.internal/schemas/research_result.schema.json",
  "title": "ResearchWorkflowResult",
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "status",
    "root_query",
    "completed_steps",
    "total_steps",
    "subqueries",
    "verified_claims",
    "citations",
    "updated_at_ms"
  ],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "job_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "completed", "cancelled", "failed", "deadline_exceeded"]
    },
    "root_query": { "type": "string" },
    "completed_steps": { "type": "integer", "minimum": 0 },
    "total_steps": { "type": "integer", "minimum": 1 },
    "subqueries": { "type": "array", "items": { "type": "string" } },
    "verified_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_text", "doc_id", "source_url", "status", "confidence_permille", "evidence_span"],
        "properties": {
          "claim_text": { "type": "string" },
          "doc_id": { "type": "integer" },
          "source_url": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["direct_support", "partial_support", "conflicting_evidence", "insufficient_evidence"]
          },
          "confidence_permille": { "type": "integer", "minimum": 0, "maximum": 1000 },
          "evidence_span": { "type": "string" }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc_id", "canonical_url", "title"],
        "properties": {
          "doc_id": { "type": "integer" },
          "canonical_url": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "updated_at_ms": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
