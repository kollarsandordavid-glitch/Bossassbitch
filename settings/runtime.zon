.{
    .schema_version = 1,
    .node_id = "node-primary-0001",
    .cluster_name = "neural-search-production",
    .environment = "production",
    .data_root = "./var/lib/neural_search",
    .worker_threads = 16,
    .io_threads = 8,
    .background_threads = 4,
    .max_heap_bytes = 68719476736,
    .arena_block_bytes = 4194304,
    .shutdown_grace_ms = 15000,
    .heartbeat_interval_ms = 1000,
    .numa_aware = true,
    .pin_worker_threads = true,
    .enable_avx512 = true,
    .enable_avx2 = true,
    .enable_neon = true,
    .enable_sve = true,
}
