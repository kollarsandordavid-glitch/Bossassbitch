[Unit]
Description=Distributed Neural Search Engine API and Query Coordinator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/user
ExecStart=/home/user/zig-out/bin/search-coordinator --role=search --config-dir=/home/user/settings --deploy-dir=/home/user/deploy
ExecStop=/bin/kill -TERM $MAINPID
Restart=always
RestartSec=2
TimeoutStopSec=20
LimitNOFILE=1048576
Environment=NEURAL_SEARCH_ROLE=search
Environment=NEURAL_SEARCH_CONFIG_DIR=/home/user/settings

[Install]
WantedBy=multi-user.target
